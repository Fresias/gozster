{
  "gozster-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|read_file|write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ../harness-kit/core/guard/guard-cli.mjs --runtime antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
