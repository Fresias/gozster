{
  "gozster-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"exec bash \\\"$(git rev-parse --show-toplevel)/.claude/hooks/guard.sh\\\" --runtime antigravity\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
