-><!--/$--><div id=\"athlete-chat-drawer\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"athlete-chat-title\" class=\"fixed inset-x-3 bottom-4 top-16 sm:inset-x-auto sm:right-6 sm:bottom-20 sm:top-auto sm:h-[540px] sm:w-96 z-50 flex flex-col rounded-2xl border border-border bg-card text-card-foreground shadow-2xl backdrop-blur transition-all animate-in fade-in-50 zoom-in-95\"><div class=\"flex items-center justify-between border-b border-border p-3.5 bg-card/95\"><div><h3 id=\"athlete-chat-title\" class=\"text-sm font-bold text-foreground flex items-center gap-2\"><span>GOZS</span><span class=\"rounded-full bg-primary/20 px-2 py-0.5 text-xs font-bold text-primary\">Equipo</span></h3><p class=\"text-xs text-muted-foreground\">Tu equipo de entrenadores GOZS</p></div><button type=\"button\" aria-label=\"Cerrar chat\" class=\"flex h-11 w-11 items-center justify-center rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground touch-manipulation min-h-11 min-w-11\">✕</button></div><div data-testid=\"push-subscription-container\" class=\"border-b border-border/60 bg-muted/20 px-3 py-2 flex items-center justify-between gap-2 text-xs\"><div class=\"flex items-center gap-1.5 min-w-0\"><span class=\"text-sm\">🔔</span><span class=\"text-xs text-muted-foreground truncate\">Avisos de respuestas del coach</span></div><button type=\"button\" data-testid=\"toggle-push-btn\" class=\"min-h-8 min-w-[90px] px-2.5 py-1 rounded-md text-xs font-bold transition-colors touch-manipulation cursor-pointer bg-primary text-primary-foreground hover:bg-primary/90\">Activar push</button></div><div class=\"flex-1 space-y-3.5 overflow-y-auto p-3.5 text-xs\" data-testid=\"athlete-chat-messages-container\"><div><div class=\"flex flex-col items-end\" data-testid=\"athlete-own-bubble-msg-lucas-1\"><div class=\"flex items-end gap-2 max-w-[90%]\"><div class=\"rounded-2xl rounded-tr-none px-3.5 py-2.5 bg-primary text-primary-foreground shadow-sm\"><p class=\"text-xs leading-relaxed\">